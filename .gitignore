cat > .gitignore << 'EOF'
# Qt Creator 本地配置
*.user
*.user.*
*.creator.user*
*.creator

# 构建目录
build*/
*-build*/
debug/
release/

# CMake
CMakeLists.txt.user
CMakeLists.txt.user.*
cmake-build-*/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt

# 编译产物
*.o
*.so
*.a
*.exe
*.dll
moc_*.cpp
moc_*.h
ui_*.h
qrc_*.cpp
*.moc

# IDE 临时文件
*~
*.swp
.DS_Store
EOF